# PostgreSQL connection — fill in your local credentials
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/change_detective

# API bind settings
API_HOST=127.0.0.1
API_PORT=3001

# Application
NODE_ENV=development
SCAN_MODE=local

# Google OAuth web application settings. In Google Cloud Console, allow this
# exact redirect URI: http://localhost:3000/api/auth/google/callback
PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Optional: let this Google account claim existing legacy device and scan data.
# BOOTSTRAP_EMAIL=you@gmail.com

# Hosted service: set SCAN_MODE=agent so scans are queued for user-enrolled
# devices instead of running on the API server.

