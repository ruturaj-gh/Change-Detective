# PostgreSQL connection — fill in your local credentials
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/change_detective

# API bind settings
API_HOST=127.0.0.1
API_PORT=3001

# Application
NODE_ENV=development
SCAN_MODE=local

# Public single-user sign-in (required when NODE_ENV=production).
# Generate a hash with: npm run auth:hash-password --workspace @change-detective/api
# Generate a secret with: openssl rand -hex 32
# AUTH_EMAIL=you@example.com
# AUTH_PASSWORD_HASH=
# AUTH_SECRET=

# Hosted service: set SCAN_MODE=agent so scans are queued for an enrolled
# Linux agent instead of running on the API server.

