{
  "name": "@change-detective/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:scanner": "npm run build --workspace @change-detective/scanner",
    "predev": "npm run build:scanner",
    "prebuild": "npm run build:scanner",
    "pretypecheck": "npm run build:scanner",
    "pretest": "npm run build:scanner",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node scripts/prisma-with-root-env.cjs migrate deploy",
    "db:migrate:dev": "node scripts/prisma-with-root-env.cjs migrate dev",
    "db:generate": "node scripts/prisma-with-root-env.cjs generate",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "node scripts/prisma-with-root-env.cjs studio"
  },
  "dependencies": {
    "@change-detective/scanner": "*",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.19.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "google-auth-library": "^11.3.4",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.19.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
